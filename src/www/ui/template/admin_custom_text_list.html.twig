{% extends "include/base.html.twig" %}

{% block styles %}
  {{ parent() }}
  <style>
    .phrase-badge-add  { background-color: #28a745; color: #fff; }
    .phrase-badge-rm   { background-color: #dc3545; color: #fff; }
  </style>
{% endblock %}

{% block content %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <p>
    {{ 'This is a list of Custom Text imported into FOSSology.'| trans }}
    {{ 'You can Export CSV/JSON or Import More custom texts. Using the following interactions provided'| trans }}
  </p>
  <a href="?mod={{ addModuleName }}&edit=0" class="btn btn-success btn-sm">
    <i class="bi bi-plus-circle"></i> {{ 'Add New'|trans }}
  </a>
</div>
<div class="card shadow-sm">
  <div class="card-body p-2">
    <table class="semibordered" id="customPhrasesTable" width="100%" cellpadding="0">
      <thead>
        <tr>
          <th>
            {{ "Licenses"|trans }}
            <img src="images/info_16.png" alt="info" class="info-bullet"
              data-toggle="tooltip" data-placement="top"
              title="{{ 'Shows licenses to be added (+ icon) or removed (− icon) when this phrase is matched by the kotoba agent'|trans }}"/>
          </th>
          <th>{{ "Text"|trans }}</th>
          <th>
            {{ "Details"|trans }}
            <img src="images/info_16.png" alt="info" class="info-bullet"
              data-toggle="tooltip" data-placement="top"
              title="{{ 'T = License Text set, A = Acknowledgement set, C = Comment set. Hover each dot to preview the content'|trans }}"/>
          </th>
          <th>{{ "Created By"|trans }}</th>
          <th>
            {{ "Actions"|trans }}
            <img src="images/info_16.png" alt="info" class="info-bullet"
              data-toggle="tooltip" data-placement="top"
              title="{{ 'Edit: modify this phrase and its license mappings. Toggle: activate or deactivate scanning for this phrase. Delete: permanently remove this phrase'|trans }}"/>
          </th>
        </tr>
      </thead>
    </table>
  </div>
</div>

{% endblock %}

{% block foot %}
  {{ parent() }}
  <script src="scripts/jquery.dataTables.min.js" type="text/javascript"></script>
  <script src="scripts/jquery.dataTables.select.js" type="text/javascript"></script>
  <script type="text/javascript">
    $(document).ready(function () {
      $('[data-toggle="tooltip"]').tooltip();
      $.fn.dataTable.ext.errMode = 'none';
      var table = $('#customPhrasesTable').DataTable({
        "processing": true,
        "serverSide": true,
        "ajax": { "url": "?mod=admin_custom_text_list&action=fetchData", "type": "GET" },
        "columns": [
          { "data": 0, "orderable": false, "render": function(d) { return d || ''; } },
          { "data": 1, "orderable": false, "render": function(d) { return d || ''; } },
          { "data": 2, "orderable": false, "render": function(d) { return d || ''; } },
          { "data": 3, "orderable": false, "render": function(d) { return d || ''; } },
          { "data": 4, "orderable": false, "render": function(d) { return d || ''; } }
        ],
        "columnDefs": [
          { "targets": [0, 1, 3], "searchable": true },
          { "targets": [2, 4], "searchable": false, "className": "text-center" }
        ],
        "pageLength": 10,
        "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]],
        "paging": true,
        "sPaginationType": "listbox",
        "stateSave": false,
        "autoWidth": false,
        "initComplete": function() {
          var $toolbar = $('<div class="btn-group btn-group-sm mr-2">' +
            '<a href="?mod=admin_custom_text_to_csv"  class="btn btn-outline-secondary">{{ "Export CSV"|trans }}</a>' +
            '<a href="?mod=admin_custom_text_to_json" class="btn btn-outline-secondary">{{ "Export JSON"|trans }}</a>' +
            '<a href="?mod=admin_custom_text_import"  class="btn btn-outline-secondary">{{ "Import"|trans }}</a>' +
            '</div>');
          $('.dataTables_filter').prepend($toolbar);
        }
      });

      $(document).on('click', '.custom-text-delete', function () {
        var phraseId = parseInt($(this).data('phrase-id'), 10);
        if (confirm("{{ 'Are you sure you want to delete this custom text? This action cannot be undone.'|trans }}")) {
          $.ajax({
            url: "?mod=admin_custom_text_list&action=delete",
            type: "POST",
            data: { id: phraseId },
            dataType: "json",
            success: function (data) {
              if (data.error) { alert("Error: " + data.error); }
              else {
                alert(data.message || "{{ 'Custom text deleted successfully!'|trans }}");
                $('#customPhrasesTable').DataTable().ajax.reload(null, false);
              }
            },
            error: function (xhr, status, error) { alert("{{ 'Error deleting text:'|trans }} " + error); }
          });
        }
      });

      $(document).on('change', '.phrase-status-toggle', function () {
        var phraseId     = parseInt($(this).data('phrase-id'), 10);
        var currentStatus = parseInt($(this).data('current-status'), 10);
        $.ajax({
          url: "?mod=admin_custom_text_list&action=toggle",
          type: "POST",
          data: { id: phraseId, status: currentStatus ? 0 : 1 },
          dataType: "json",
          success: function (data) {
            if (data.error) { alert("Error: " + data.error); }
            else { $('#customPhrasesTable').DataTable().ajax.reload(null, false); }
          },
          error: function (xhr, status, error) { alert("{{ 'Error toggling status:'|trans }} " + error); }
        });
      });
    });
  </script>
{% endblock %}
