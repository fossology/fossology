{% extends "base.html.twig" %}

{% block content %}
<div class="container" style="max-width: 500px; margin-top: 50px;">
  <h2>{{ "Reset Password"|trans }}</h2>

  {% if error %}
    <div class="alert alert-danger" role="alert">
      {{ error }}
    </div>
  {% endif %}

  {% if success %}
    <div class="alert alert-success" role="alert">
      {{ success }}
    </div>
    <a href="?mod=auth" class="btn btn-primary">{{ "Go to Login"|trans }}</a>
  {% else %}
    {% if token %}
      <form method="post" action="?mod=auth&action=reset-password">
       <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="token" value="{{ token }}">
        <div class="form-group">
          <label for="new_password">{{ "New Password"|trans }}</label>
          <input type="password" class="form-control" id="new_password" name="new_password" required autofocus>
        </div>
        <div class="form-group" style="margin-top: 10px;">
          <label for="confirm_password">{{ "Confirm New Password"|trans }}</label>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 15px;">{{ "Reset Password"|trans }}</button>
      </form>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
