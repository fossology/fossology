{% extends "base.html.twig" %}

{% block content %}
<form method="post" action="?mod=auth&action=forgot-password">
  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
  <div class="form-group">
    <label for="identifier">{{ "Username or Email Address"|trans }}</label>
    <input type="text" class="form-control" id="identifier" name="identifier" required autofocus>
  </div>
  <button type="submit" class="btn btn-primary" style="margin-top: 15px;">{{ "Send Reset Link"|trans }}</button>
  <a href="?mod=auth" class="btn btn-default" style="margin-top: 15px;">{{ "Back to Login"|trans }}</a>
</form>
<div class="container" style="max-width: 500px; margin-top: 50px;">
  <h2>{{ "Forgot Password"|trans }}</h2>
  
  {% if message %}
    <div class="alert alert-info" role="alert">
      {{ message }}
    </div>
  {% endif %}

  <form method="post" action="?mod=auth&action=forgot-password">
    <div class="form-group">
      <label for="identifier">{{ "Username or Email Address"|trans }}</label>
      <input type="text" class="form-control" id="identifier" name="identifier" required autofocus>
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top: 15px;">{{ "Send Reset Link"|trans }}</button>
    <a href="?mod=auth" class="btn btn-default" style="margin-top: 15px;">{{ "Back to Login"|trans }}</a>
  </form>
</div>
{% endblock %}
